# ─── CareNexus Backend Environment Variables ─────────
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql://medibot_user:medibot_pass@localhost:5432/medibot

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (generate a real one: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-in-production-use-a-real-secret-key

# LLM Provider (openai / gemini / ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

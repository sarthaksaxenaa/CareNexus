# ─── CareNexus backend configuration ───────────────────────────────
# Copy to backend/.env. Every value is optional for local development:
# with no .env at all the API runs on SQLite with offline (RAG) triage.
# Never commit the real .env file.

# App
ENVIRONMENT=development
DEBUG=false

# Database: SQLite file by default. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/carenexus
DATABASE_URL=sqlite:///./carenexus.db

# JWT signing key. Required (32+ chars) when ENVIRONMENT=production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-production-use-a-real-secret-key

# CORS: JSON list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional LLM. Without a key, triage uses the offline RAG + rules engine.
# LLM_PROVIDER: gemini | openai.  LLM_MODEL empty = provider default.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Rate limits (requests per minute)
RATE_LIMIT_CHAT=10
RATE_LIMIT_AUTH=5
# Set true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
